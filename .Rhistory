ls
ls -l
r --v
r -version
version
traceback()
# ---- loading libraries ----
pacman::p_load(tidyverse, modelsummary, kableExtra)
# ---- simulate dataset ----
set.seed(20251216)
n <- 400
age <- pmin(pmax(round(rnorm(n, mean = 48, sd=12)), 20), 85)
edu_yrs <- pmin(pmax(round(rnorm(n, mean = 14, sd=2.5)), 6), 20)
party_id <- sample(c("DPP","KMT","TPP","Other"),
size = n, replace = TRUE,
prob = c(0.365, 0.215, 0.115, 0.305))
media_literacy <- pmin(pmax(rnorm(n, mean=4.3, sd = 2.1),0) ,10)
party_shift <- ifelse(party_id == "KMT", 0.8,
ifelse(party_id == "TPP", -0.4,
ifelse(party_id == "DPP", -0.6, 0.0)))
disinfo_exposure <- 5 - 0.5 * media_literacy + party_shift + rnorm(n, mean=2.5, sd=1.4)
disinfo_exposure <- pmin(pmax(disinfo_exposure, 0), 10)
party_def <- ifelse(party_id == "DPP", 6,
ifelse(party_id == "KMT", -4,
ifelse(party_id == "TPP", -1, 0)))
defense_support <- 60 - 2.4 * disinfo_exposure + 1.2 * media_literacy +
0.08 * edu_yrs - 0.05 * age + party_def + rnorm(n, 0, 10)
defense_support <- pmin(pmax(defense_support, 0), 100)
dat_sim <- data.frame(defense_support, disinfo_exposure,
media_literacy, age, edu_yrs, party_id)
# ---- descriptive data for continuous variables----
datasummary(All(dat_sim) ~
Mean + SD + Min + Median + Max,
data = dat_sim,
output = "kableExtra")
# ---- descriptive data for categorical variable ----
datasummary_skim(
dat_sim,
type = "categorical",
output="kableExtra")
# ---- histogramss ----
var_labels <- c(
defense_support  = "Defense support (0–100)",
disinfo_exposure = "Disinformation exposure (0–10)",
media_literacy   = "Media literacy (0–10)",
age              = "Age (years)"
)
dat_sim %>%
pivot_longer(all_of(names(var_labels))) %>%
ggplot(aes(value)) +
geom_histogram(bins = 25, fill = "orange", color = "white") +
facet_wrap(~name, scales = "free_x", ncol = 4,
labeller = labeller(name = var_labels)) +
labs(title = "Distributions of Key Variables (Simulated Data)", x = "", y = "") +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold"),
strip.text = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
# ---- Shapiro-wilk Test ----
shapiro.test(
dat_sim$age)
shapiro.test(
dat_sim$defense_support)
shapiro.test(
dat_sim$disinfo_exposure)
shapiro.test(
dat_sim$media_literacy)
# ---- OLS ----
ggplot(dat_sim, aes(x = disinfo_exposure, y = defense_support)) +
geom_point(alpha = 0.35, size = 0.8) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1.0, color="orange") +
scale_x_continuous(breaks = 0:10) +
scale_y_continuous(limits = c(10, 100)) +
labs(
title = "Disinformation Exposure and Support for Defense Spending in Taiwan (Simulated)",
subtitle = "Points are individuals; line is OLS fit with 95% CI",
x = "Disinformation exposure (0–10)",
y = "Support for increasing defense spending (0–100)"
) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
panel.grid.minor = element_blank()
)
# ---- Model Test ----
models <- list(
"OLS" = lm(defense_support ~ disinfo_exposure, data = dat_sim),
"Poission" = glm(defense_support ~ disinfo_exposure, family = poisson, data = dat_sim),
"OLS with Controls" = lm(defense_support ~ disinfo_exposure +
media_literacy + age + edu_yrs + party_id, data = dat_sim))
modelsummary(models, stars=TRUE, estimate  = "{estimate} {stars} ({std.error})",
statistic = NULL, gof_omit = "AIC|BIC|Log.Lik.", output="kableExtra")%>%
kableExtra::kable_styling(bootstrap_options = c("striped", "condensed"))%>%
kableExtra::row_spec(0, extra_css = "padding-top: 2px; padding-bottom: 2px;")
